<!DOCTYPE html>
<html lang="fr-BE">
  <head>
    <title><%= seo_title %></title>
    <meta name="description" content="<%= seo_description %>">
    <meta name="robots" content="<%= seo_robots %>">
    <% if seo_indexable_page? %>
      <link rel="canonical" href="<%= seo_canonical_url %>">
      <meta property="og:type" content="website">
      <meta property="og:locale" content="fr_BE">
      <meta property="og:site_name" content="La Ferme d’Auwez">
      <meta property="og:title" content="<%= seo_title %>">
      <meta property="og:description" content="<%= seo_description %>">
      <meta property="og:url" content="<%= seo_canonical_url %>">
      <meta property="og:image" content="<%= seo_image_url %>">
      <meta property="og:image:alt" content="<%= content_for?(:social_image_alt) ? content_for(:social_image_alt) : "Vue sur la campagne depuis la Ferme d’Auwez à Ciney" %>">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="<%= seo_title %>">
      <meta name="twitter:description" content="<%= seo_description %>">
      <meta name="twitter:image" content="<%= seo_image_url %>">
      <script type="application/ld+json"><%= raw json_escape(seo_structured_data) %></script>
    <% end %>
    <%# CALENDRIER DÉSACTIVÉ : réactiver cette feuille de style avec le pin Flatpickr. %>
    <%# <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"> %>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Pinyon+Script&display=swap" rel="stylesheet">
    <%= render "shared/google_analytics", measurement_id: ENV["GA4_MEASUREMENT_ID"] if ENV["GA4_MEASUREMENT_ID"].present? %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :turnstile_script %>
  </head>

  <body>
    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>

    <%= yield %>
    <%= render "shared/footer" %>

  </body>
</html>
