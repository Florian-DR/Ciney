 <div class="navbar">  
    <a href="/"><%= image_tag "logo-hirondelle-400.webp", alt: "Logo de la Ferme d'Auwez", class: "logo", width: 400, height: 284, fetchpriority: "high", decoding: "async" %></a>

    <%# Desktop navbar %>
    <nav class="desktop-nav"> 
        <a href="/" class="nav-link">La Ferme d'Auwez</a>
        <div id="gites-nav" class="nav-link" style="position: relative">
            Nos gîtes
            <div class="sub-div">
                <% @nav_gites.each do |gite| %>
                    <%= link_to gite.name, gite_path(gite), class: "sub-link" %>
                <% end %>
            </div>
        </div>
        <%= link_to "Team buildings", team_buildings_path, class: "nav-link" %>
        <%= link_to "Activités", activities_path, class: "nav-link" %>
        <a href="/about" class="nav-link">À propos</a>
        <a href="/contact" class="nav-link">Contact et accès</a>
        <a href="https://bookingengine.mylighthouse.com/la-ferme-dauwez-Ciney?language=fr-FR" target='_blank' class="button">Réservation</a>
    </nav>

    <%# Phone navbar %>
    <nav class="phone-nav" data-controller="display-toggle" >
        <div class="nav-button" data-action="click->display-toggle#toggleDisplay">
            <i class="fa-solid fa-bars"></i>
        </div>
        <div class="modal-component d-none" data-display-toggle-target="toToggle">
            <div class="modal-component-content modal-nav-phone">
                <div class="nav-button" style="padding: 32px 2vw;" data-action="click->display-toggle#toggleDisplay">
                    <i class="fa-solid fa-bars"></i>
                </div>
                <div class="phone-links">
                    <a href="/" class="nav-link">Accueil</a>
                    <% @nav_gites.each do |gite| %>
                        <%= link_to gite.name, gite_path(gite), class: "nav-link" %>
                    <% end %>
                    <%= link_to "Team buildings", team_buildings_path, class: "nav-link" %>
                    <%= link_to "Activités", activities_path, class: "nav-link" %>
                    <a href="/about" class="nav-link">À propos</a>
                    <a href="/contact" class="nav-link">Contact et accès</a>
                    <a href="https://bookingengine.mylighthouse.com/la-ferme-dauwez-Ciney?language=fr-FR" target='_blank' class="button">Réservation</a>
                </div>
            </div>
        </div>
    </nav>
</div>
