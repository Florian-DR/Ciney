<section class="gite-stats" aria-label="Caractéristiques principales du gîte">
  <div class="gite-page-contain gite-stats__grid">
    <div class="gite-stats__item">
      <strong><%= gite.capacity %></strong>
      <span>personnes accueillies</span>
    </div>
    <div class="gite-stats__item">
      <strong><%= gite.rooms %></strong>
      <span>chambres</span>
    </div>
    <div class="gite-stats__item">
      <i class="<%= feature_icon %>" aria-hidden="true"></i>
      <span><%= feature %></span>
    </div>
    <div class="gite-stats__item">
      <i class="fa-solid fa-water-ladder" aria-hidden="true"></i>
      <span>piscines &amp; sauna partagés</span>
    </div>
  </div>
</section>
