<footer id="site-footer" class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__main">
      <section class="site-footer__brand" aria-labelledby="footer-brand-title">
        <%= link_to root_path, class: "site-footer__logo-link", aria: { label: "Accueil — La Ferme d’Auwez" } do %>
          <%= image_tag "logo-ciney-500.webp", alt: "", class: "site-footer__logo", width: 500, height: 296, loading: "lazy", decoding: "async" %>
        <% end %>
        <h2 id="footer-brand-title" class="visually-hidden">La Ferme d’Auwez</h2>
        <p class="site-footer__intro">Un séjour authentique en pleine nature, entre charme, confort et moments partagés.</p>
        <div class="site-footer__details">
          <address class="site-footer__contact">
            <a href="https://www.google.com/maps/search/?api=1&amp;query=50.2797711%2C5.1338991" target="_blank" rel="noopener">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>Route d’Auwez 1<br>5590 Ciney, Belgique</span>
            </a>
            <a href="mailto:lafermedauwez@gmail.com">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <span>lafermedauwez@gmail.com</span>
            </a>
          </address>
          <div class="site-footer__socials" aria-label="Réseaux sociaux">
            <%= link_to "https://www.facebook.com/fermedauwez", target: "_blank", rel: "noopener", aria: { label: "La Ferme d’Auwez sur Facebook" } do %>
              <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
            <% end %>
            <%= link_to "https://instagram.com/fermedauwez", target: "_blank", rel: "noopener", aria: { label: "La Ferme d’Auwez sur Instagram" } do %>
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            <% end %>
          </div>
        </div>
      </section>

      <nav class="site-footer__nav" aria-labelledby="footer-discover-title">
        <h2 id="footer-discover-title">Découvrir</h2>
        <ul>
          <% @nav_gites.each do |gite| %>
            <li><%= link_to gite.name, gite_path(gite) %></li>
          <% end %>
          <li><%= link_to "Domaine en exclusivité", domain_path %></li>
          <li><%= link_to "Séjours professionnels", team_buildings_path %></li>
          <li><%= link_to "Activités aux alentours", activities_path %></li>
        </ul>
      </nav>

      <div class="site-footer__secondary-navs">
        <nav class="site-footer__nav" aria-labelledby="footer-info-title">
          <h2 id="footer-info-title">Informations</h2>
          <ul>
            <li><%= link_to "À propos", about_path %></li>
            <li><%= link_to "Contact et accès", contact_path %></li>
          </ul>
        </nav>

        <nav class="site-footer__nav" aria-labelledby="footer-legal-title">
          <h2 id="footer-legal-title">Informations légales</h2>
          <ul>
            <li><button type="button" class="site-footer__text-button" data-action="analytics-consent#manage">Gérer les cookies</button></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© <%= Time.current.year %> La Ferme d’Auwez</p>
      <p>Ciney, Belgique</p>
    </div>
  </div>
</footer>
