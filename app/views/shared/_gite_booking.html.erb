<section class="gite-booking">
  <div class="gite-page-contain">
    <p class="gite-section-kicker">Votre séjour à la Ferme d’Auwez</p>
    <h2><%= gite.name %></h2>
    <div class="gite-booking__actions">
      <%= link_to booking_url,
          target: "_blank",
          rel: "noopener",
          class: "button",
          data: {
            action: "click->analytics-consent#trackReservation",
            analytics_consent_emplacement_param: analytics_emplacement
          } do %>
        Réserver <%= gite.name %> <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      <% end %>
      <%= link_to "Modifier", edit_gite_path(gite), class: "button" if current_user == User.first %>
    </div>
  </div>
</section>
