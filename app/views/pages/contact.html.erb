<% content_for :title, "Contact et accès | La Ferme d’Auwez à Ciney" %>
<% content_for :description, "Contactez la Ferme d’Auwez et préparez votre arrivée : Route d’Auwez 1 à Ciney, accès, gares proches et informations pratiques pour votre séjour." %>
<% content_for :social_image, "coucher-de-soleil-1920.webp" %>
<% content_for :social_image_alt, "Coucher de soleil sur la campagne autour de la Ferme d’Auwez" %>
<% content_for :uncontainerize, true %>
<%= image_tag "coucher-de-soleil-1920.webp",
    alt: "Coucher de soleil sur le panorama de la Ferme d'Auwez",
    id: "contact-banner",
    srcset: {
      "coucher-de-soleil-960.webp" => "960w",
      "coucher-de-soleil-1920.webp" => "1920w"
    },
    sizes: "100vw",
    width: 1920,
    height: 1440,
    loading: "eager",
    fetchpriority: "high",
    decoding: "async" %>

<div id="contact" class="contain">   

    <%####  Contact et Information  #####%>
    <h1 class="heading-h3">Une question ?</h1>
    <p>Que ce soit pour une réservation, un devis ou toute autre question, contactez-nous. Nous vous répondrons au plus vite.</p>
    <p style="color: #0061c8ff; text-decoration: underline">lafermedauwez@gmail.com</p>

    <div id="contact-info">
    <!--

        <div class="form-container">
            <h2 class="heading-h3">📩 Contactez-nous</h2>
            <%= form_with url: "/contact", class: "contact-form form" do |form| %>
                <div class="double-fields">
                    <%= form.text_field :name, placeholder: "Nom *", required: true%>
                    <%= form.text_field :first_name, placeholder: "Prénom *", required: true%>
                </div>
                <div class="double-fields">
                    <%= form.text_field :email, placeholder: "Email *", required: true %>
                    <%= form.telephone_field :telephone, placeholder: "Téléphone *", required: true %>
                </div>
                <%= form.text_area :message, placeholder: "Votre message *", required: true %>
                <%= form.text_field :url, placeholder: "url", class: "fake-field", tabindex: "-1"%>
                <%= form.submit :Envoyer, class: "button" %>
            <% end %>
        </div>
        -->

        <div class="access-container">
            <h2 class="heading-h3">📍 Accès et informations pratiques</h2>
            <div class="contacts-info">
                <i class="fa-solid fa-location-dot"></i><p>Route d’Auwez 1
                    5590 Ciney
                    Belgique
                </p>
                <p><i class="fa-solid fa-car-side"></i> Parking sur place
                <i class="fa-solid fa-train"></i> Gare la plus proche : Leignon ou Ciney
                <i class="fa-solid fa-bicycle"></i> Accès direct aux pistes cyclables EuroVélo 5 et RAVeL</p>
            </div>
        </div>
    </div>

    <%####  Map  #####%>
    <div class="map">
        <h2 class="heading-h3">Plan d'accès</h2>
        <iframe class="frame" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3389.9094445526566!2d5.129731238770262!3d50.28120116033405!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c1b774f1edc2b9%3A0x5796df9c9e20a1a7!2sG%C3%AEtes%20%C3%A0%20la%20Ferme%20d&#39;Auwez!5e0!3m2!1sfr!2sbe!4v1742051030968!5m2!1sfr!2sbe" 
            width="100%" 
            height="600" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>
</div>
