<% content_for :title, "Gîtes avec piscine à Ciney | La Ferme d’Auwez" %>
<% content_for :description, "Séjournez à la Ferme d’Auwez, au cœur du Condroz : gîtes de 4 à 25 personnes avec piscine intérieure, sauna, jardin et vue sur la campagne." %>
<% content_for :social_image, "coucher-de-soleil-1920.webp" %>
<% content_for :social_image_alt, "Vue panoramique au coucher du soleil depuis la Ferme d’Auwez" %>

<%###### Carousel Section ######%>
<div id="carousel-container" class="carousel slide carousel-fade" data-bs-ride="carousel slide fade" data-bs-touch="true">
    <%= video_tag 'vue-gites-ciney.mp4', autoplay: :autoplay, loop: true, muted: :muted, playsinline: true, preload: 'metadata', style: "width: 100vw; height: auto" %>
</div>

<%###### Introduction Section ######%>
<div class="soleil-container">
    <div class="border-btm"></div>
    <div class="soleil"></div>
    <div class="border-btm"></div>
</div>

<div class="home-introduction">
    <h1 class="heading-h2">Un lieu où nature et authenticité se rencontrent</h1>
    <p>Bienvenue à la Ferme d’Auwez, une ancienne ferme au cœur du Condroz belge, entièrement rénovée avec charme et authenticité pour vous offrir un cadre chaleureux, paisible et dépaysant. Nichée dans un environnement verdoyant, la ferme est idéale pour se ressourcer, déconnecter du quotidien et profiter d’un séjour en toute sérénité.
    Nous proposons trois gîtes spacieux, avec piscines et sauna partagé. Pensés pour accueillir jusqu’à 25 personnes, ils sont parfaits pour des vacances en famille, des retrouvailles entre amis, des séminaires ou des événements privés. La capacité modulable de nos hébergements s’adapte à tous les besoins, dans un cadre unique alliant confort moderne et charme rural.</p>
    <%= link_to "En savoir plus sur notre histoire", about_path(), class: "button" %>
</div>

<%###### Gites Section ######%>
<% gite_features = {
    "Les Hirondelles" => "Grands groupes, convivialité et feu de bois",
    "L'Horizon" => "Terrasse panoramique et vue sur le Condroz",
    "L'Arbre de Vie" => "Plain-pied et accessibilité PMR"
} %>
<section id="gites" class="home-gites" aria-labelledby="home-gites-title">
    <div class="home-gites__heading">
        <p class="home-gites__eyebrow">Trois maisons, trois atmosphères</p>
        <h2 id="home-gites-title">Choisissez le gîte qui vous ressemble</h2>
        <p>En famille ou entre amis, trouvez l’espace qui accueillera vos prochains moments partagés au cœur du Condroz.</p>
    </div>

    <div class="home-gites__grid">
        <% @home_gites.each do |gite| %>
            <article class="home-gite-card">
                <div class="home-gite-card__image">
                    <%= responsive_attachment_tag(
                        gite,
                        :main_photo,
                        alt: "Photo principale du gîte #{gite.name}",
                        variant: :medium,
                        sizes: "(max-width: 768px) calc(100vw - 40px), 30vw",
                        loading: "lazy",
                        decoding: "async"
                    ) if gite.main_photo %>
                </div>

                <div class="home-gite-card__content">
                    <h3><%= gite.name %></h3>
                    <div class="home-gite-card__facts" aria-label="Informations principales">
                        <span><i class="fa-solid fa-user-group" aria-hidden="true"></i><%= gite.capacity %> personnes</span>
                        <span><i class="fa-solid fa-bed" aria-hidden="true"></i><%= gite.rooms %> chambres</span>
                    </div>
                    <p class="home-gite-card__feature"><%= gite_features.fetch(gite.name) %></p>
                    <%= link_to gite_path(gite), class: "home-gite-card__link" do %>
                        Découvrir <%= gite.name %>
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    <% end %>
                </div>
            </article>
        <% end %>
    </div>
</section>

<%###### Domaine en exclusivité Section ######%>
<section class="home-domain" aria-labelledby="home-domain-title">
        <div class="home-domain__inner">
            <div class="home-domain__media">
                <%= image_tag(
                    "domaine-moment-partage-1920.webp",
                    srcset: {
                        "domaine-moment-partage-960.webp" => "960w",
                        "domaine-moment-partage-1920.webp" => "1920w"
                    },
                    sizes: "(max-width: 768px) calc(100vw - 40px), 58vw",
                    alt: "Famille et amis réunis dans le jardin de la Ferme d’Auwez",
                    loading: "lazy",
                    decoding: "async"
                ) %>
            </div>

            <div class="home-domain__content">
                <p class="home-domain__eyebrow">La Ferme rien que pour vous</p>
                <h2 id="home-domain-title">Le domaine en exclusivité</h2>
                <p class="home-domain__intro">Réunissez votre grande famille, votre cousinade ou votre groupe d’amis dans un lieu entièrement réservé à vos moments partagés.</p>

                <div class="home-domain__facts" aria-label="Capacité du domaine">
                    <span><strong>3</strong> gîtes réunis</span>
                    <span><strong>25</strong> personnes</span>
                    <span><strong>10</strong> chambres</span>
                </div>

                <ul class="home-domain__benefits">
                    <li><i class="fa-solid fa-water-ladder" aria-hidden="true"></i><span>Piscines et sauna privatisés</span></li>
                    <li><i class="fa-solid fa-people-roof" aria-hidden="true"></i><span>Grange et mezzanine en accès exclusif</span></li>
                    <li><i class="fa-solid fa-utensils" aria-hidden="true"></i><span>Cuisine adaptée aux groupes, avec possibilité de faire appel à un chef ou à un traiteur</span></li>
                    <li><i class="fa-solid fa-tree" aria-hidden="true"></i><span>Jardin et extérieurs réservés à votre groupe</span></li>
                </ul>

                <%= link_to domain_path, class: "button home-domain__link" do %>
                    Découvrir le domaine en exclusivité
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                <% end %>
            </div>
        </div>
</section>

<%###### Séjours professionnels Section ######%>
<section id="sejours-professionnels" class="home-professional" aria-labelledby="home-professional-title">
    <div class="home-professional__inner">
        <div class="home-professional__content">
            <p class="home-professional__eyebrow">Travailler, créer du lien, se ressourcer</p>
            <h2 id="home-professional-title">Séjours professionnels &amp; bien-être</h2>
            <p class="home-professional__intro">Entreprises, associations, formateurs et organisateurs de stages trouvent ici un cadre au vert où les temps de travail laissent naturellement place aux échanges et à la respiration.</p>

            <div class="home-professional__capacity">
                <i class="fa-solid fa-house-laptop" aria-hidden="true"></i>
                <p><strong>Séjours résidentiels</strong><span>Jusqu’à 25 personnes dans 10 chambres</span></p>
            </div>

            <ul class="home-professional__uses">
                <li><i class="fa-solid fa-people-group" aria-hidden="true"></i><span>Une salle polyvalente pour les réunions, formations, ateliers et pratiques de bien-être</span></li>
                <li><i class="fa-solid fa-calendar-day" aria-hidden="true"></i><span>La possibilité d’organiser une journée sans hébergement</span></li>
                <li><i class="fa-solid fa-utensils" aria-hidden="true"></i><span>Un accompagnement pour la restauration et les activités</span></li>
            </ul>

            <%= link_to team_buildings_path, class: "button home-professional__link" do %>
                Découvrir les séjours professionnels
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            <% end %>
        </div>

        <div class="home-professional__media">
            <%= image_tag(
                "salle-polyvalente-reunion-1400.webp",
                srcset: {
                    "salle-polyvalente-reunion-640.webp" => "640w",
                    "salle-polyvalente-reunion-1400.webp" => "1400w"
                },
                sizes: "(max-width: 768px) calc(100vw - 40px), 50vw",
                alt: "Salle polyvalente de la Ferme d’Auwez aménagée pour une réunion",
                loading: "lazy",
                decoding: "async"
            ) %>
            <p class="home-professional__media-note">Réunions · Formations · Ateliers · Bien-être</p>
        </div>
    </div>
</section>

<%###### Les plus du domaine Section ######%>
<section id="plus-du-domaine" class="home-amenities" aria-labelledby="home-amenities-title">
    <div class="home-amenities__heading">
        <p class="home-amenities__eyebrow">Prendre le temps, simplement</p>
        <h2 id="home-amenities-title">Les plus du domaine</h2>
        <p>Après une balade, une journée de travail ou simplement pour le plaisir, profitez des espaces de détente de la Ferme d’Auwez.</p>
    </div>

    <div class="home-amenities__showcase">
        <article class="home-amenity-card home-amenity-card--indoor">
            <%= image_tag(
                "piscine-interieure-sauna-ferme-auwez.webp",
                srcset: {
                    "piscine-interieure-sauna-ferme-auwez-960.webp" => "960w",
                    "piscine-interieure-sauna-ferme-auwez.webp" => "2048w"
                },
                sizes: "(max-width: 768px) calc(100vw - 40px), 58vw",
                alt: "Piscine intérieure de la Ferme d’Auwez",
                loading: "lazy",
                decoding: "async"
            ) %>
            <div class="home-amenity-card__caption home-amenity-card__caption--double">
                <div>
                    <i class="fa-solid fa-water-ladder" aria-hidden="true"></i>
                    <h3>Piscine intérieure</h3>
                    <p>Accessible toute l’année</p>
                </div>
                <div>
                    <i class="fa-solid fa-temperature-high" aria-hidden="true"></i>
                    <h3>Sauna</h3>
                    <p>Une chaleur douce pour ralentir</p>
                </div>
            </div>
        </article>

        <article class="home-amenity-card home-amenity-card--outdoor">
            <%= image_tag(
                "piscine-exterieure-ferme-auwez-1920.webp",
                srcset: {
                    "piscine-exterieure-ferme-auwez-960.webp" => "960w",
                    "piscine-exterieure-ferme-auwez-1920.webp" => "1920w"
                },
                sizes: "(max-width: 768px) calc(100vw - 40px), 36vw",
                alt: "Piscine extérieure avec vue sur la campagne du Condroz",
                loading: "lazy",
                decoding: "async"
            ) %>
            <div class="home-amenity-card__caption">
                <i class="fa-solid fa-person-swimming" aria-hidden="true"></i>
                <h3>Piscine extérieure</h3>
                <p>Une parenthèse au grand air face à la campagne</p>
            </div>
        </article>
    </div>

    <div class="home-amenities__shared">
        <i class="fa-solid fa-people-group" aria-hidden="true"></i>
        <p><strong>Des espaces partagés.</strong> Lorsque les gîtes sont loués séparément, les piscines et le sauna sont partagés entre les hôtes des trois gîtes.</p>
    </div>

    <ul class="home-amenities__secondary" aria-label="Autres avantages du domaine">
        <li><i class="fa-solid fa-seedling" aria-hidden="true"></i>Vaste jardin</li>
        <li><i class="fa-solid fa-people-roof" aria-hidden="true"></i>Grange conviviale</li>
        <li><i class="fa-solid fa-square-parking" aria-hidden="true"></i>Parking sur place</li>
        <li><i class="fa-solid fa-charging-station" aria-hidden="true"></i>Bornes de recharge</li>
        <li><i class="fa-solid fa-tree" aria-hidden="true"></i>Nature du Condroz</li>
    </ul>
</section>

<%###### Activités dans la région Section ######%>
<section id="activites-region" class="home-activities" aria-labelledby="home-activities-title">
    <%= image_tag(
        "condroz-sentier-coucher-1920.webp",
        srcset: {
            "condroz-sentier-coucher-960.webp" => "960w",
            "condroz-sentier-coucher-1920.webp" => "1920w"
        },
        sizes: "100vw",
        alt: "Sentier dans une prairie du Condroz au coucher du soleil",
        class: "home-activities__image",
        loading: "lazy",
        decoding: "async"
    ) %>
    <div class="home-activities__overlay" aria-hidden="true"></div>

    <div class="home-activities__inner">
        <div class="home-activities__content">
            <p class="home-activities__eyebrow">Le Condroz à votre porte</p>
            <h2 id="home-activities-title">Explorer les environs</h2>
            <p>Partez à pied ou à vélo sur les chemins vallonnés, puis laissez-vous surprendre par les villages, le patrimoine et les saveurs de la région.</p>

            <ul class="home-activities__themes" aria-label="Aperçu des activités régionales">
                <li><i class="fa-solid fa-person-hiking" aria-hidden="true"></i>Balades et grand air</li>
                <li><i class="fa-solid fa-bicycle" aria-hidden="true"></i>Parcours vélo</li>
                <li><i class="fa-solid fa-landmark" aria-hidden="true"></i>Découvertes culturelles</li>
                <li><i class="fa-solid fa-wheat-awn" aria-hidden="true"></i>Escapades gourmandes</li>
            </ul>

            <%= link_to activities_path, class: "button home-activities__link" do %>
                Découvrir les activités de la région
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            <% end %>
        </div>
    </div>
</section>

<%###### Visitors Section ######%>
<div id="visitors-container" class="bg-green">
    <h2 class="visitors-heading">Ils ont séjourné chez nous...</h2>
    <div class="visitors-cards">
        <div class="visitor-card">
            <div class="quote-container"> <%= image_tag "quotation.png", alt: "", class: "quote-mark", width: 53, height: 40, loading: "lazy", decoding: "async" %></div>
            <p class="visitor-text">Endroit exceptionnel, avec des hôtes d’exception !
                On s’y sent comme à la maison ! De chouettes balades à faire, des petites villes ou villages à proximité à visiter, ou juste profiter du cadre !
                C’est tout simplement formidable !
            </p>
            <div class="stars">
                <% 5.times do %>
                    <%= image_tag "star.png", alt: "", width: 47, height: 47, loading: "lazy", decoding: "async" %>
                <% end %>
            </div>
            <span>Charles dW.</span>
        </div>

        <div class="visitor-card">
            <div class="quote-container"> <%= image_tag "quotation.png", alt: "", class: "quote-mark", width: 53, height: 40, loading: "lazy", decoding: "async" %></div>
            <p class="visitor-text">Un endroit sublime et chaleureux !
                 Des chambres parfaites pour se reposer et profiter du calme de la campagne.
                  Une vue sublime sur le terroir du coin ! 
                  À recommander, sans hésitation !
            </p>
            <div class="stars">
                <% 5.times do %>
                    <%= image_tag "star.png", alt: "", width: 47, height: 47, loading: "lazy", decoding: "async" %>
                <% end %>
            </div>
            <span>Christophe G.</span>
        </div>

    </div>
</div>
