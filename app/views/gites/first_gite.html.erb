<% content_for :title, "Gîte Les Hirondelles à Ciney – 15 personnes | Ferme d’Auwez" %>
<% content_for :description, "Les Hirondelles accueille 15 personnes à Ciney : maison familiale, grands espaces, feu de bois, piscine intérieure, sauna et jardin au cœur du Condroz." %>
<% content_for :social_image, "cour-interieur-1400.webp" %>
<% content_for :social_image_alt, "Cour intérieure du gîte Les Hirondelles à la Ferme d’Auwez" %>
<% content_for :uncontainerize, true %>
<main class="gite-page">
    <%= responsive_attachment_tag @gite, :main_photo, alt: Photo.get_alt(@gite.main_photo), id: "gite-banner", variant: :large, sizes: "100vw", loading: "eager", fetchpriority: "high", decoding: "async" if @gite.main_photo %>

    <%= render "shared/gite_stats", gite: @gite, feature: "Convivialité & feu de bois", feature_icon: "fa-solid fa-fire" %>

    <section class="gite-intro gite-page-contain">
        <div class="gite-intro__primary">
            <h1><%= @gite.name %></h1>
            <h2 class="heading-h3">Un gîte spacieux et chaleureux pour des moments inoubliables</h2>
            <p>Nichée au cœur du domaine de la Ferme d’Auwez, Les Hirondelles est une maison familiale entièrement rénovée qui allie authenticité et confort moderne. Avec sa capacité d’accueil de 15 personnes, ses grands espaces conviviaux et son ambiance chaleureuse, ce gîte est parfait pour les retrouvailles, les célébrations et les séjours en groupe.</p>
        </div>
        <div class="gite-intro__secondary">
            <h2 class="heading-h3">Un lieu pensé pour la convivialité et le partage</h2>
            <p>Au sein de cette maison de caractère, tout a été conçu pour créer des souvenirs inoubliables. Que ce soit autour du feu en hiver, lors d’un apéritif sur la terrasse ou dans la grande salle à manger, profitez d’un cadre propice aux échanges et à la détente.</p>
            <ul class="gite-intro__highlights">
                <li><b>Capacité :</b> jusqu'à <%= @gite.capacity%> personnes</li>
                <li><b>Idéal pour :</b> grandes familles, groupes d'amis, retraites en groupe</li>
                <li><b>Ambiance :</b> chaleureuse, conviviale et authentique</li>
            </ul>
        </div>
    </section>

    <section id="galerie" class="gite-gallery-section">
        <div class="gite-page-contain">
            <p class="gite-section-kicker">Le gîte en images</p>
            <h2>Découvrez <%= @gite.name %></h2>
            <%= render "shared/gite_gallery", gite: @gite %>
        </div>
    </section>

    <%= render "shared/gite_spaces", sections: [
        {
            icon: "fa-solid fa-house",
            title: "Rez-de-chaussée : un espace de vie convivial",
            items: [
                "Grand salon avec cassette à bois : ambiance chaleureuse garantie pour les soirées d’hiver",
                "Cuisine entièrement équipée : idéale pour préparer des repas en groupe",
                "Salle à manger spacieuse avec poêle à bois : pour partager de bons moments tous ensemble"
            ]
        },
        {
            icon: "fa-solid fa-film",
            title: "Deuxième étage : détente et divertissement",
            items: [
                "2 dortoirs (3 et 4 lits)",
                "Espace de jeux pour petits et grands",
                "Salle de bain supplémentaire avec douche et toilettes"
            ]
        },
        {
            icon: "fa-solid fa-bed",
            title: "Premier étage : confort et intimité",
            items: ["4 chambres doubles avec literie de qualité", "3 salles de bains modernes"]
        },
        {
            icon: "fa-solid fa-screwdriver-wrench",
            title: "Équipements inclus",
            items: ["Linge de maison fourni (draps, serviettes)", "Wifi gratuit", "Chauffage central", "Stationnement sur place"]
        }
    ] %>

    <%= render "shared/gite_domain_extras" %>
    
    <%= render "shared/gite_practical",
        gite: @gite,
        arrival_label: "Arrivée & Départ",
        image: "cour-interieur-1400.webp",
        image_alt: "Cour intérieure de la Ferme d'Auwez",
        srcset: { "cour-interieur-640.webp" => "640w", "cour-interieur-1400.webp" => "1400w" },
        image_width: 1400,
        image_height: 1050 %>

    <%= render "shared/gite_booking",
        gite: @gite,
        booking_url: "https://bookingengine.mylighthouse.com/la-ferme-dauwez-Ciney?language=fr-FR&room=53680",
        analytics_emplacement: "fiche_hirondelles" %>
</main>
