<% content_for :title, "Gîte L’Horizon à Ciney – 6 personnes | Ferme d’Auwez" %>
<% content_for :description, "L’Horizon accueille 6 personnes à Ciney : gîte lumineux, terrasse privée avec vue sur le Condroz, piscine intérieure, sauna et jardin." %>
<% content_for :social_image, "gite-horizon-1400.webp" %>
<% content_for :social_image_alt, "Gîte L’Horizon et sa vue sur la campagne de Ciney" %>
<% content_for :uncontainerize, true %>
<main class="gite-page">
    <%= responsive_attachment_tag @gite, :main_photo, alt: Photo.get_alt(@gite.main_photo), id: "gite-banner", variant: :large, sizes: "100vw", loading: "eager", fetchpriority: "high", decoding: "async" if @gite.main_photo %>

    <%= render "shared/gite_stats", gite: @gite, feature: "Terrasse avec vue panoramique", feature_icon: "fa-solid fa-mountain-sun" %>

    <section class="gite-intro gite-page-contain">
        <div class="gite-intro__primary">
            <h1><%= @gite.name %></h1>
            <h2 class="heading-h3">Un gîte lumineux avec une vue imprenable sur la campagne</h2>
            <p>Le gîte L’Horizon vous accueille dans un cadre paisible avec une terrasse privée offrant une vue exceptionnelle sur la campagne condruzienne. Idéal pour les petites familles et les groupes d’amis, ce gîte allie charme, confort et modernité pour un séjour en toute tranquillité.</p>
        </div>

        <div class="gite-intro__secondary">
            <h2 class="heading-h3">Un cocon de sérénité avec une vue imprenable</h2>
            <p>Avec sa lumière naturelle abondante et son atmosphère chaleureuse, L’Horizon est le gîte parfait pour une escapade relaxante. Sa terrasse privée vous permettra de profiter d’un panorama unique sur les collines du Condroz, du lever au coucher du soleil.</p>
            <ul class="gite-intro__highlights">
                <li><b>Une vue panoramique inégalée :</b> Terrasse privée avec panorama exceptionnel sur le Condroz.</li>
                <li><b>Capacité :</b> jusqu'à <%= @gite.capacity%> personnes</li>
                <li><b>Idéal pour :</b> petites familles, couples, groupes d’amis</li>
                <li><b>Ambiance :</b> cosy, paisible, ressourçante</li>
                <li><b>Extensible :</b> possibilité de fusionner pour obtenir Le Grand Horizon</li>
            </ul>
        </div>
    </section>

    <section id="galerie" class="gite-gallery-section">
        <div class="gite-page-contain">
            <p class="gite-section-kicker">Le gîte en images</p>
            <h2>Découvrez <%= @gite.name %></h2>
            <%= render "shared/gite_gallery", gite: @gite %>
        </div>
    </section>

    <%= render "shared/gite_spaces", sections: [
        {
            icon: "fa-solid fa-house",
            title: "Rez-de-chaussée : confort et accessibilité",
            items: [
                "Salon cosy et lumineux avec grandes fenêtres donnant sur la terrasse",
                "Cuisine ouverte et équipée pour cuisiner en toute simplicité",
                "Chambre double avec literie haut de gamme",
                "Salle de bain moderne avec douche spacieuse"
            ]
        },
        {
            icon: "fa-solid fa-screwdriver-wrench",
            title: "Équipements inclus",
            items: ["Linge de maison fourni (draps, serviettes)", "Wifi gratuit", "Chauffage central", "Stationnement sur place", "Terrasse privée avec mobilier extérieur"]
        },
        {
            icon: "fa-solid fa-bed",
            title: "Étage : flexibilité et espace",
            items: ["Grande chambre de 4 lits et vue dégagée sur nos contrées", "Rangements intégrés pour un séjour tout en confort"]
        }
    ] %>

    <%= render "shared/gite_domain_extras" %>
    
    <%= render "shared/gite_practical",
        gite: @gite,
        arrival_label: "Arrivée & Départ",
        image: "gite-horizon-1400.webp",
        image_alt: "Gîte L'Horizon vu depuis la rue",
        srcset: { "gite-horizon-640.webp" => "640w", "gite-horizon-1400.webp" => "1400w" },
        image_width: 1400,
        image_height: 1228 %>

    <%= render "shared/gite_booking",
        gite: @gite,
        booking_url: "https://bookingengine.mylighthouse.com/la-ferme-dauwez-Ciney?language=fr-FR&room=53681",
        analytics_emplacement: "fiche_horizon" %>
</main>
