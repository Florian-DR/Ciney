<div class="contain">

    <%= link_to gite_path do %>
        <p class="button"><i class="fa-solid fa-circle-arrow-left"></i> Retour</p>
    <% end %>
    <%= render "shared/tuto"%>

    <%= simple_form_for @gite, html: { multipart: true } do |f| %>
        <%= f.input :name %>
        <%= f.input :main_photo, as: :hidden, input_html: { value: @gite.main_photo_data }%>
        <%= f.input :main_photo, as: :file, label: "Changer la photo PRINCIPALE" %>
        <%= f.input :description %>
        <%= f.input :capacity %>
        <%= f.input :rooms %>
        <%= f.input :sanitary %>
        <%= f.input :commun %>
        <%= f.input :photos, as: :file, label: "Ajouter des photos", input_html: {multiple: true}  %>
        <%= f.submit "Valider les modifications", class: "button"%>
    <% end %>

    <hr/>
    <p>Gérer mes photos</p>
    <% if !@gite.photos.empty? %>
        <div class="my-photos">
            <% @gite.photos.each_with_index do |photo, index| %>
                <div>
                    <%= responsive_attachment_tag photo, :image, alt: photo.get_alt, variant: :small, variants: %i[small], sizes: "240px", loading: "lazy", decoding: "async" if photo.image %>

                    <%= link_to delete_pictures_path(@gite, photo_id: photo.id), data: {turbo_method: :delete, turbo_confirm: "Es-tu sûr de vouloir supprimer cette photo ?"}, class: "text-danger" do %>
                        <i class="fa-solid fa-trash"></i>
                    <% end %>
                    
                        <%# <i class="fa-solid fa-chevron-left"></i> %>
                        <%# <i class="fa-solid fa-chevron-right"></i>  %>
                </div>
            <% end %>
        </div>
    <% else %>
        <p> Il n'y a aucune photos </p>
    <% end %>
</div>
